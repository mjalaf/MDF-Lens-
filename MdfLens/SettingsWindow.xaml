<Window x:Class="MdfLens.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings &amp; About — MDF Lens" 
        Height="640" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="app_icon.ico"
        Background="{DynamicResource ThemeWindowBg}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Window.Resources>
        <Style x:Key="SettingOptionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeBorderSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeAccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Scrollable content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="{DynamicResource ThemeAccentSoft}" CornerRadius="10" Margin="0,0,12,0" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.2">
                        <Path Data="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.8" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSettingsHeader" Text="Settings &amp; About" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                        <TextBlock Text="MDF Lens Studio — Preferences, System &amp; Changelog" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Scrollable Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16" Padding="0,0,8,0">
            <StackPanel>

                <!-- SECTION 1: APPEARANCE & THEME -->
                <TextBlock x:Name="TxtSecAppearance" Text="Appearance &amp; Theme" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Light Theme Card -->
                    <Border x:Name="CardThemeLight" Grid.Column="0" Style="{StaticResource SettingOptionCard}" MouseLeftButtonDown="CardThemeLight_Click">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="36" Height="36" Background="#FEF3C7" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="☀️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtThemeLightTitle" Text="Light (White)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    <TextBlock x:Name="BadgeLightActive" Text="ACTIVE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="8,2,0,0" Visibility="Visible"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtThemeLightSub" Text="Crisp, modern light aesthetic" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Dark Theme Card -->
                    <Border x:Name="CardThemeDark" Grid.Column="2" Style="{StaticResource SettingOptionCard}" MouseLeftButtonDown="CardThemeDark_Click">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="36" Height="36" Background="#0F172A" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center" BorderBrush="#334155" BorderThickness="1">
                                <TextBlock Text="🌙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtThemeDarkTitle" Text="Dark (Slate)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    <TextBlock x:Name="BadgeDarkActive" Text="ACTIVE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="8,2,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtThemeDarkSub" Text="Deep slate high-contrast dark aesthetic" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- SECTION 2: LANGUAGE & LOCALIZATION -->
                <TextBlock x:Name="TxtSecLanguage" Text="Language &amp; Localization" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- English Card -->
                    <Border x:Name="CardLangEn" Grid.Column="0" Style="{StaticResource SettingOptionCard}" MouseLeftButtonDown="CardLangEn_Click">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="36" Height="36" Background="{DynamicResource ThemeBorderSubtle}" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="🌐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="EN — English" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    <TextBlock x:Name="BadgeLangEnActive" Text="ACTIVE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="8,2,0,0" Visibility="Visible"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtLangEnSub" Text="English (Default)" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Spanish Card -->
                    <Border x:Name="CardLangEs" Grid.Column="2" Style="{StaticResource SettingOptionCard}" MouseLeftButtonDown="CardLangEs_Click">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="36" Height="36" Background="{DynamicResource ThemeBorderSubtle}" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="🌐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ES — Español" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    <TextBlock x:Name="BadgeLangEsActive" Text="ACTIVE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="8,2,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtLangEsSub" Text="Spanish (Español)" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- SECTION 3: ABOUT MDF LENS -->
                <TextBlock x:Name="TxtSecAbout" Text="About MDF Lens" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Border Width="40" Height="40" Background="{DynamicResource ThemeAccentSoft}" CornerRadius="10" Margin="0,0,12,0" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5">
                                    <Path Data="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="2" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="MDF Lens Studio" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                        <Border Background="{DynamicResource ThemeAccentSoft}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="v1.2.0" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Modern Microsoft SQL Server Database Inspector" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock x:Name="TxtAboutDesc" Text="High-performance SQL Server (.mdf) database inspector and studio. Easily open, inspect, query, and export databases without needing a full SQL Server instance." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" LineHeight="17" Margin="0,0,0,14"/>

                        <Border Background="{DynamicResource ThemeBorderSubtle}" CornerRadius="6" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="LblVer" Text="Version:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,16,4"/>
                                <TextBlock Grid.Column="1" Text="1.2.0 (Build 2026.10)" FontSize="11.5" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" x:Name="LblArch" Text="Architecture:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,16,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text=".NET 8.0 Windows (win-x64) • WPF Desktop" FontSize="11.5" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="2" x:Name="LblEngine" Text="Engine:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,16,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Microsoft SQL Server LocalDB v16.0 + Direct 8KB Page Decoder" FontSize="11.5" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="3" Text="License:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,16,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="MIT License • Open Source" FontSize="11.5" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- SECTION 4: CHANGELOG & RECENT UPDATES -->
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="TxtSecChangelog" Text="Recent Changes &amp; Release Notes" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Button Click="BtnOpenChangelogFile_Click" Style="{StaticResource BtnSecondary}" DockPanel.Dock="Right" Padding="10,4" FontSize="11">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtBtnOpenChangelog" Text="Open CHANGELOG.md" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <Border Background="{DynamicResource ThemeCodeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <TextBox x:Name="TxtChangelogContent" 
                             Background="Transparent" 
                             Foreground="{DynamicResource ThemeTextPrimary}" 
                             FontFamily="Cascadia Code, Consolas, Courier New" 
                             FontSize="11.5" 
                             IsReadOnly="True" 
                             BorderThickness="0" 
                             TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto" 
                             Height="180"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="0,12,0,0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="MDF Lens Studio • Created for high-performance database inspection" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <Button x:Name="BtnCloseDialog" Click="BtnCloseDialog_Click" Style="{StaticResource BtnPrimary}" Content="Close" DockPanel.Dock="Right" MinWidth="90"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
