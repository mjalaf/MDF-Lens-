<Window x:Class="MdfLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MDF Lens — MDF Database Inspector &amp; Studio"
        Height="840" Width="1380"
        MinHeight="620" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        Background="{DynamicResource ThemeWindowBg}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        Icon="app_icon.ico"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <!-- Modern Primary Button -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Outline Button -->
        <Style x:Key="BtnOutline" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeBorderSubtle}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Danger Button (Detach/Close) -->
        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeDangerBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeDangerText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeDangerBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Activity Bar Nav Item Button -->
        <Style x:Key="ActivityBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource ThemeBorderSubtle}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActivityBarBtnActive" TargetType="Button" BasedOn="{StaticResource ActivityBarBtn}">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="templateRoot" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="6">
                <Border x:Name="splitBorder" 
                        Width="18" 
                        HorizontalAlignment="Right" 
                        Margin="0">
                    <Path x:Name="arrow" 
                          Data="M0 0 L3.5 3.5 L7 0 Z" 
                          Fill="{DynamicResource ThemeTextSecondary}" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource ThemeAccent}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3,18,3"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot">
                            <ToggleButton x:Name="toggleButton" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Focusable="False"/>

                            <ContentPresenter x:Name="contentPresenter" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              IsHitTestVisible="False" 
                                              Margin="{TemplateBinding Padding}" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" 
                                   Margin="1">
                                <Border x:Name="dropDownBorder" 
                                        Background="{DynamicResource ThemeCardBg}" 
                                        BorderBrush="{DynamicResource ThemeBorder}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}" 
                                        Padding="2"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="True">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="toggleButton" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Top App Bar -->
            <RowDefinition Height="Auto"/> <!-- 2. Grouped Action Sub-Toolbar -->
            <RowDefinition Height="*"/>    <!-- 3. Main Workspace: Activity Bar + Sidebar + Content + Inspector -->
            <RowDefinition Height="Auto"/> <!-- 4. Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. TOP APP BAR -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel LastChildFill="False">
                <!-- Left: App Logo & Title + Status Pill -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- Lens Icon -->
                    <Border Width="30" Height="30" Background="{DynamicResource ThemeAccentSoft}" CornerRadius="8" Margin="0,0,8,0" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1">
                        <Path Data="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <TextBlock Text="MDF Lens" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtAppSubtitle" Text=" — MDF Database Inspector &amp; Studio" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="2,0,12,0"/>

                    <!-- Breadcrumb / Database status pill -->
                    <Border Background="{DynamicResource ThemeBorderSubtle}" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="TopPillDot" Width="7" Height="7" Fill="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTopBreadcrumb" Text="No file loaded | Open an MDF file to begin" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Dropdown Language & Theme Switchers + Settings Action -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Language Dropdown -->
                    <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" Fill="{DynamicResource ThemeTextSecondary}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="CmbLanguage" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11.5" Height="26" VerticalContentAlignment="Center" SelectionChanged="CmbLanguage_SelectionChanged">
                                <ComboBoxItem Content="EN (English)" IsSelected="True"/>
                                <ComboBoxItem Content="ES (Español)"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Theme Dropdown -->
                    <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="PathThemeIcon" Data="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="CmbTheme" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11.5" Height="26" VerticalContentAlignment="Center" SelectionChanged="CmbTheme_SelectionChanged">
                                <ComboBoxItem Content="Light" IsSelected="True"/>
                                <ComboBoxItem Content="Dark"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Top Bar Settings & About Button -->
                    <Button Click="NavBtnSettings_Click" Style="{StaticResource BtnOutline}" Height="28" Padding="10,2" ToolTip="Open Settings &amp; About">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z" Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtTopSettingsBtn" Text="Settings" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. GROUPED ACTION SUB-TOOLBAR -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="14,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- GROUP 1: Database & File -->
                    <StackPanel Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- Open MDF with dropdown -->
                            <Button x:Name="BtnOpenMdf" Click="BtnOpenMdf_Click" Style="{StaticResource BtnPrimary}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3 4a1 1 0 011-1h4a1 1 0 01.8.4l1.2 1.6H20a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V4z" Fill="White" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtBtnOpenMdf" Text="Open MDF ▾" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Attach / Detect DBs -->
                            <Button x:Name="BtnDetectedMdfs" Click="BtnDetectedMdfs_Click" Style="{StaticResource BtnOutline}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4 7v10c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3V7c0-2-1.5-3-3.5-3h-9C5.5 4 4 5 4 7z" Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="TxtBtnAttachDetect" Text="Attach / Detect DBs ▾" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MenuDetectedDbs"/>
                                </Button.ContextMenu>
                            </Button>

                            <!-- Refresh -->
                            <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Style="{StaticResource BtnOutline}" Margin="0,0,4,0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4 4v5h5M20 20v-5h-5M4 12a8 8 0 0114.9-4M20 12a8 8 0 01-14.9 4" Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="1.6" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="TxtBtnRefresh" Text="Refresh" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="TxtGroupDatabaseFile" Text="Database &amp; File" FontSize="9.5" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="28" Fill="{DynamicResource ThemeBorder}" Margin="4,2,12,2" VerticalAlignment="Top"/>

                    <!-- GROUP 2: Query & Export -->
                    <StackPanel Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- Run Query -->
                            <Button x:Name="BtnRunQueryTop" Click="BtnRunQueryTop_Click" Style="{StaticResource BtnOutline}" Margin="0,0,6,0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M5 3l14 9-14 9V3z" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="TxtBtnRunQuery" Text="Run Query" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Export -->
                            <Button x:Name="BtnExportTable" Click="BtnExportTable_Click" Style="{StaticResource BtnOutline}" Margin="0,0,4,0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" Stroke="#10B981" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="TxtBtnExport" Text="Export ▾" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="MenuCsvItem" Header="Export to CSV (.csv)" Click="MenuExportCsv_Click"/>
                                        <MenuItem x:Name="MenuTsvItem" Header="Export to Excel / TSV (.tsv)" Click="MenuExportTsv_Click"/>
                                        <MenuItem x:Name="MenuJsonItem" Header="Export to JSON (.json)" Click="MenuExportJson_Click"/>
                                        <MenuItem x:Name="MenuSqlItem" Header="Export as SQL Script (.sql)" Click="MenuExportSql_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="TxtGroupQueryExport" Text="Query &amp; Export" FontSize="9.5" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="28" Fill="{DynamicResource ThemeBorder}" Margin="4,2,12,2" VerticalAlignment="Top"/>

                    <!-- GROUP 3: Connection -->
                    <StackPanel>
                        <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource BtnDanger}" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M6 18L18 6M6 6l12 12" Stroke="{DynamicResource ThemeDangerText}" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="TxtBtnDetachClose" Text="Detach / Close DB" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="TxtGroupConnection" Text="Connection" FontSize="9.5" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. MAIN WORKSPACE -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68"/>  <!-- Col 0: Far-Left Activity Bar -->
                <ColumnDefinition Width="270" MinWidth="210" MaxWidth="450"/> <!-- Col 1: Left Database Explorer -->
                <ColumnDefinition Width="Auto"/> <!-- Splitter 1 -->
                <ColumnDefinition Width="*"/>   <!-- Col 2: Center Workspace -->
                <ColumnDefinition Width="Auto"/> <!-- Splitter 2 -->
                <ColumnDefinition Width="260" MinWidth="200" MaxWidth="400"/> <!-- Col 3: Right Inspector Panel -->
            </Grid.ColumnDefinitions>

            <!-- COL 0: FAR-LEFT ACTIVITY BAR -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeActivityBarBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>    <!-- Top Nav Items -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Settings Item -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,10,0,0">
                        <!-- Home -->
                        <Button x:Name="NavBtnHome" Click="NavBtnHome_Click" Style="{StaticResource ActivityBarBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavHome" Text="Home" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Tables (Active by default) -->
                        <Button x:Name="NavBtnTables" Click="NavBtnTables_Click" Style="{StaticResource ActivityBarBtnActive}">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavTables" Text="Tables" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Query -->
                        <Button x:Name="NavBtnQuery" Click="NavBtnQuery_Click" Style="{StaticResource ActivityBarBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavQuery" Text="Query" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Binary Header -->
                        <Button x:Name="NavBtnHeader" Click="NavBtnHeader_Click" Style="{StaticResource ActivityBarBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavHeader" Text="Binary Header" FontSize="9.5" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>

                        <!-- Export -->
                        <Button x:Name="NavBtnExport" Click="NavBtnExport_Click" Style="{StaticResource ActivityBarBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavExport" Text="Export" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Settings (Bottom docked) -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button x:Name="NavBtnSettings" Click="NavBtnSettings_Click" Style="{StaticResource ActivityBarBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavSettings" Text="Settings" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- COL 1: LEFT DATABASE EXPLORER SIDEBAR -->
            <Border Grid.Column="1" Background="{DynamicResource ThemeSidebarBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Search -->
                        <RowDefinition Height="*"/>    <!-- Tables List / Empty Placeholder -->
                        <RowDefinition Height="Auto"/> <!-- Bottom File Metadata Card -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="14,14,14,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Data="M4 7v10c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3V7c0-2-1.5-3-3.5-3h-9C5.5 4 4 5 4 7z" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtExplorerTitle" Text="Database Explorer" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Search Box -->
                        <Border Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" Stroke="{DynamicResource ThemeTextMuted}" StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtSearchTables" Grid.Column="1" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" FontSize="12" TextChanged="TxtSearchTables_TextChanged"/>
                                <TextBlock x:Name="PlaceholderSearchTables" Grid.Column="1" Text="Search tables..." Foreground="{DynamicResource ThemeTextMuted}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearchTables}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <CheckBox x:Name="ChkIncludeViews" Content="Include Views &amp; System Objects" Margin="2,8,0,0" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Checked="ChkIncludeViews_Changed" Unchecked="ChkIncludeViews_Changed"/>
                    </StackPanel>

                    <!-- Table List / Empty State in Sidebar -->
                    <Grid Grid.Row="1">
                        <!-- Populated Tree/List -->
                        <ListBox x:Name="ListTables" Background="Transparent" BorderThickness="0" SelectionChanged="ListTables_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,7"/>
                                    <Setter Property="Margin" Value="6,2"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Path Grid.Column="0" Data="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12.5" Foreground="{DynamicResource ThemeTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding RowCountFormatted}" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ThemeBorderSubtle}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Empty Placeholder inside Sidebar -->
                        <Border x:Name="SidebarEmptyState" Background="Transparent" Visibility="Visible" VerticalAlignment="Center" Margin="14">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="48" Height="48" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource ThemeBorderSubtle}" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Path Data="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" Stroke="{DynamicResource ThemeTextMuted}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtNoTablesAvailable" Text="No tables available" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtNoTablesSub" Text="Open an MDF file to see database tables." FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bottom File Metadata Card -->
                    <Border Grid.Row="2" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="14,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Path Data="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="TxtFileMetaHeader" Text="FILE METADATA" FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtSqlVersionBadge" Text="SQL Server" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <TextBlock x:Name="TxtDbName" Text="No file loaded" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtFileSubInfo" Text="Open or drag an .mdf file" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter 1 -->
            <GridSplitter Grid.Column="2" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource ThemeBorder}" Cursor="SizeWE"/>

            <!-- COL 2: CENTER WORKSPACE -->
            <Grid Grid.Column="3" Background="{DynamicResource ThemeContentBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Workspace Header (Title + Stat pills) -->
                    <RowDefinition Height="Auto"/> <!-- Filter Toolbar -->
                    <RowDefinition Height="*"/>    <!-- Tabs Content -->
                    <RowDefinition Height="Auto"/> <!-- Pagination Toolbar -->
                </Grid.RowDefinitions>

                <!-- Workspace Header: Table Name & Stat Pills -->
                <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="18,12">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <!-- Table Blue Badge -->
                            <Border Width="36" Height="36" Background="{DynamicResource ThemeAccentSoft}" CornerRadius="8" Margin="0,0,12,0" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1">
                                <Path Data="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtCurrentTableName" Text="Select a table from the sidebar" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCurrentTableSub" Text="" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtCurrentTablePrompt" Text="Open an MDF file to inspect records." FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Stat Pills on Right -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Border Background="{DynamicResource ThemeBadgeBg}" CornerRadius="12" Padding="10,3" Margin="0,0,6,0">
                                <TextBlock x:Name="PillRowCount" Text="0 rows" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeBadgeText}"/>
                            </Border>
                            <Border x:Name="ContainerPillCols" Background="{DynamicResource ThemeBorderSubtle}" CornerRadius="12" Padding="10,3" Margin="0,0,6,0" Visibility="Collapsed">
                                <TextBlock x:Name="PillColCount" Text="0 columns" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                            </Border>
                            <Border x:Name="ContainerPillSchema" Background="{DynamicResource ThemeBorderSubtle}" CornerRadius="12" Padding="10,3" Visibility="Collapsed">
                                <TextBlock x:Name="PillSchemaName" Text="Schema: dbo" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Filter Toolbar & Tabs Switcher Header -->
                <Border Grid.Row="1" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="16,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Tab Headers -->
                            <RowDefinition Height="Auto"/> <!-- Filter input controls -->
                        </Grid.RowDefinitions>

                        <!-- Segmented Tab Underline Headers -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="TabBtnData" Click="TabBtnData_Click" Style="{StaticResource ActivityBarBtnActive}" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtTabBtnData" Text="Data Grid" FontWeight="SemiBold" FontSize="12"/>
                            </Button>
                            <Button x:Name="TabBtnColumns" Click="TabBtnColumns_Click" Style="{StaticResource ActivityBarBtn}" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtTabBtnColumns" Text="Schema &amp; Columns" FontWeight="SemiBold" FontSize="12"/>
                            </Button>
                            <Button x:Name="TabBtnQuery" Click="TabBtnQuery_Click" Style="{StaticResource ActivityBarBtn}" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtTabBtnQuery" Text="SQL Studio" FontWeight="SemiBold" FontSize="12"/>
                            </Button>
                            <Button x:Name="TabBtnBinary" Click="TabBtnBinary_Click" Style="{StaticResource ActivityBarBtn}">
                                <TextBlock x:Name="TxtTabBtnBinary" Text="Binary Header" FontWeight="SemiBold" FontSize="12"/>
                            </Button>
                        </StackPanel>

                        <!-- Filter Controls Row -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="CmbColumns" Grid.Column="0" Margin="0,0,8,0" Height="30" VerticalContentAlignment="Center" Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeBorder}"/>

                            <Border Grid.Column="1" Margin="0,0,8,0" Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <Grid>
                                    <TextBox x:Name="TxtFilterValue" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" VerticalAlignment="Center" KeyDown="TxtFilterValue_KeyDown"/>
                                    <TextBlock x:Name="PlaceholderFilterValue" Text="Type value to filter..." Foreground="{DynamicResource ThemeTextMuted}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtFilterValue}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Button x:Name="BtnSearchFilter" Grid.Column="2" Click="BtnSearchFilter_Click" Style="{StaticResource BtnPrimary}" Margin="0,0,6,0" Height="30" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" Fill="White" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtBtnFilter" Text="Filter" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnClearFilter" Grid.Column="3" Click="BtnClearFilter_Click" Style="{StaticResource BtnOutline}" Margin="0,0,6,0" Height="30" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M6 18L18 6M6 6l12 12" Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="2" Width="9" Height="9" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtBtnClear" Text="Clear" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnColumnsDropdown" Click="TabBtnColumns_Click" Grid.Column="4" Style="{StaticResource BtnOutline}" Height="30" Padding="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z" Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtBtnColumnsDropdown" Text="Columns ▾" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- TAB CONTENTS CONTAINER -->
                <Grid Grid.Row="2">
                    <!-- VIEW 1: DATA GRID -->
                    <Grid x:Name="ViewDataGrid" Visibility="Visible">
                        <DataGrid x:Name="GridData" 
                                  AutoGenerateColumns="True" 
                                  IsReadOnly="True" 
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="All" 
                                  HorizontalGridLinesBrush="{DynamicResource ThemeGridLines}" 
                                  VerticalGridLinesBrush="{DynamicResource ThemeGridLines}"
                                  Background="{DynamicResource ThemeContentBg}"
                                  RowBackground="{DynamicResource ThemeGridRowBg}"
                                  AlternatingRowBackground="{DynamicResource ThemeGridRowAltBg}"
                                  BorderThickness="0"
                                  ColumnHeaderHeight="32"
                                  RowHeight="26"
                                  FontSize="12"
                                  Foreground="{DynamicResource ThemeTextPrimary}"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  AutoGeneratingColumn="GridData_AutoGeneratingColumn"
                                  LoadingRow="GridData_LoadingRow">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource ThemeGridHeaderBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>

                        <!-- Centered Welcome / Empty State with Folder Icon and Dashed Drop Zone -->
                        <Border x:Name="OverlayEmpty" Background="{DynamicResource ThemeContentBg}" Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                                <!-- Big Folder with Sparkles Illustration -->
                                <Border Width="72" Height="72" Background="{DynamicResource ThemeAccentSoft}" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,16" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1">
                                    <Path Data="M3 4a1 1 0 011-1h4a1 1 0 01.8.4l1.2 1.6H20a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V4z" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="2" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock x:Name="TxtWelcomeTitle" Text="Start exploring your database" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtWelcomeSub" Text="Open any .mdf file from your disk or drag &amp; drop it directly into this window." FontSize="12.5" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Center" Margin="0,6,0,18" TextWrapping="Wrap" TextAlignment="Center"/>

                                <Button Click="BtnOpenMdf_Click" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Center" Padding="20,10" Margin="0,0,0,24">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M3 4a1 1 0 011-1h4a1 1 0 01.8.4l1.2 1.6H20a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V4z" Fill="White" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtBtnBrowsePrompt" Text="Browse MDF File..." FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <!-- Dashed Drop Target Card -->
                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1.5" CornerRadius="10" Padding="18,12" Background="{DynamicResource ThemeBorderSubtle}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" Stroke="{DynamicResource ThemeTextMuted}" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="TxtDropHereHint" Text="Or drag and drop an .mdf file here&#x0a;to open it directly" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Loading Spinner Overlay -->
                        <Border x:Name="OverlayLoading" Background="#60000000" Visibility="Collapsed">
                            <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ProgressBar IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="Loading..." FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- VIEW 2: SCHEMA & COLUMNS -->
                    <Grid x:Name="ViewColumnsGrid" Visibility="Collapsed">
                        <DataGrid x:Name="GridColumns" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  CanUserAddRows="False"
                                  GridLinesVisibility="All" 
                                  HorizontalGridLinesBrush="{DynamicResource ThemeGridLines}" 
                                  VerticalGridLinesBrush="{DynamicResource ThemeGridLines}"
                                  Background="{DynamicResource ThemeContentBg}"
                                  RowBackground="{DynamicResource ThemeGridRowBg}"
                                  AlternatingRowBackground="{DynamicResource ThemeGridRowAltBg}"
                                  BorderThickness="0"
                                  ColumnHeaderHeight="32"
                                  RowHeight="26"
                                  FontSize="12"
                                  Foreground="{DynamicResource ThemeTextPrimary}">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource ThemeGridHeaderBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColGridNum" Header="#" Binding="{Binding ColumnId}" Width="45"/>
                                <DataGridTextColumn x:Name="ColGridName" Header="Column Name" Binding="{Binding ColumnName}" Width="200"/>
                                <DataGridTextColumn x:Name="ColGridType" Header="Data Type" Binding="{Binding DataType}" Width="140"/>
                                <DataGridTextColumn x:Name="ColGridLength" Header="Max Length" Binding="{Binding MaxLength}" Width="95"/>
                                <DataGridCheckBoxColumn x:Name="ColGridNullable" Header="Nullable" Binding="{Binding IsNullable}" Width="75"/>
                                <DataGridCheckBoxColumn x:Name="ColGridPk" Header="Primary Key" Binding="{Binding IsPrimaryKey}" Width="100"/>
                                <DataGridCheckBoxColumn x:Name="ColGridIdentity" Header="Identity" Binding="{Binding IsIdentity}" Width="80"/>
                                <DataGridTextColumn x:Name="ColGridDefault" Header="Default Value" Binding="{Binding DefaultValue}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- VIEW 3: SQL STUDIO -->
                    <Grid x:Name="ViewQueryStudio" Visibility="Collapsed" Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="130"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <Button x:Name="BtnExecuteQuery" Click="BtnExecuteQuery_Click" Style="{StaticResource BtnPrimary}" DockPanel.Dock="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M5 3l14 9-14 9V3z" Fill="White" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtBtnExecuteQuery" Text="Execute Query (F5)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="TxtQueryTip" Text="Run custom SELECT queries against the database" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </DockPanel>

                        <Border Grid.Row="1" Background="{DynamicResource ThemeCodeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
                            <TextBox x:Name="TxtSqlQuery" 
                                     Background="Transparent" 
                                     Foreground="{DynamicResource ThemeAccent}" 
                                     FontFamily="Cascadia Code, Consolas, Courier New" 
                                     FontSize="12.5" 
                                     AcceptsReturn="True" 
                                     AcceptsTab="True"
                                     BorderThickness="0"
                                     Text="SELECT TOP 50 * FROM [dbo].[Sim_Tabla_001];"
                                     KeyDown="TxtSqlQuery_KeyDown"/>
                        </Border>

                        <DockPanel Grid.Row="2" Margin="0,8,0,8">
                            <TextBlock x:Name="TxtQueryStatus" Text="Ready to execute" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}" DockPanel.Dock="Left"/>
                        </DockPanel>

                        <DataGrid x:Name="GridQueryResult" 
                                  Grid.Row="3"
                                  AutoGenerateColumns="True" 
                                  IsReadOnly="True" 
                                  CanUserAddRows="False"
                                  GridLinesVisibility="All" 
                                  HorizontalGridLinesBrush="{DynamicResource ThemeGridLines}" 
                                  VerticalGridLinesBrush="{DynamicResource ThemeGridLines}"
                                  Background="{DynamicResource ThemeContentBg}"
                                  RowBackground="{DynamicResource ThemeGridRowBg}"
                                  AlternatingRowBackground="{DynamicResource ThemeGridRowAltBg}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource ThemeBorder}"
                                  ColumnHeaderHeight="30"
                                  RowHeight="25"
                                  FontSize="11.5"
                                  Foreground="{DynamicResource ThemeTextPrimary}"/>
                    </Grid>

                    <!-- VIEW 4: BINARY HEADER -->
                    <ScrollViewer x:Name="ViewBinaryHeader" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24" MaxWidth="800" HorizontalAlignment="Left">
                            <TextBlock x:Name="TxtHeaderTitle" Text="Binary MDF File Analysis" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtHeaderSub" Text="Decoded directly from Page 0 (File Header) &amp; Page 9 (DBINFO Boot Page)" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,16"/>

                            <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="LblHdrFile" Grid.Row="0" Grid.Column="0" Text="File Name:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtInfoFileName" Grid.Row="0" Grid.Column="1" Text="-" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>

                                    <TextBlock x:Name="LblHdrDb" Grid.Row="1" Grid.Column="0" Text="Internal DB Name:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtInfoDbName" Grid.Row="1" Grid.Column="1" Text="-" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" VerticalAlignment="Center"/>

                                    <TextBlock x:Name="LblHdrSql" Grid.Row="2" Grid.Column="0" Text="SQL Server Version:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtInfoSqlVersion" Grid.Row="2" Grid.Column="1" Text="-" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" VerticalAlignment="Center"/>

                                    <TextBlock x:Name="LblHdrBuild" Grid.Row="3" Grid.Column="0" Text="Internal Build Version:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtInfoInternalVersion" Grid.Row="3" Grid.Column="1" Text="-" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>

                                    <TextBlock x:Name="LblHdrSize" Grid.Row="4" Grid.Column="0" Text="File Size:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtInfoFileSize" Grid.Row="4" Grid.Column="1" Text="-" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>

                                    <TextBlock x:Name="LblHdrPages" Grid.Row="5" Grid.Column="0" Text="Total 8KB Pages:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtInfoTotalPages" Grid.Row="5" Grid.Column="1" Text="-" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>

                                    <TextBlock x:Name="LblHdrCompat" Grid.Row="6" Grid.Column="0" Text="Engine Compatibility:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtInfoCompatible" Grid.Row="6" Grid.Column="1" Text="-" Foreground="#10B981" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource ThemeAccentSoft}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <TextBlock x:Name="TxtPageNote" Text="MDF files store data in fixed 8,192-byte pages. This studio extracts their internal structure and utilizes LocalDB for high-speed browsing." FontSize="11.5" Foreground="{DynamicResource ThemeTextPrimary}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- PAGINATION BAR -->
                <Border Grid.Row="3" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="16,6">
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="TxtPaginationSummary" Text="Showing 0 - 0 of 0 records" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="BtnPageFirst" Click="BtnPageFirst_Click" Style="{StaticResource BtnOutline}" Padding="6,2" Margin="0,0,4,0" Content="|&lt;" IsEnabled="False"/>
                            <Button x:Name="BtnPagePrev" Click="BtnPagePrev_Click" Style="{StaticResource BtnOutline}" Padding="6,2" Margin="0,0,6,0" Content="&lt;" IsEnabled="False"/>

                            <TextBlock x:Name="TxtLblPage" Text="Page" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtCurrentPageNumber" Text="1" Width="32" Height="22" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeBorder}" FontSize="11.5" KeyDown="TxtCurrentPageNumber_KeyDown"/>
                            <TextBlock x:Name="TxtTotalPagesCount" Text="of 1" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="4,0,6,0"/>

                            <Button x:Name="BtnPageNext" Click="BtnPageNext_Click" Style="{StaticResource BtnOutline}" Padding="6,2" Margin="0,0,4,0" Content="&gt;" IsEnabled="False"/>
                            <Button x:Name="BtnPageLast" Click="BtnPageLast_Click" Style="{StaticResource BtnOutline}" Padding="6,2" Margin="0,0,10,0" Content="&gt;|" IsEnabled="False"/>

                            <ComboBox x:Name="CmbPageSize" Width="105" Height="24" VerticalContentAlignment="Center" Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeBorder}" SelectionChanged="CmbPageSize_SelectionChanged">
                                <ComboBoxItem Content="25 rows per page"/>
                                <ComboBoxItem Content="50 rows per page" IsSelected="True"/>
                                <ComboBoxItem Content="100 rows per page"/>
                                <ComboBoxItem Content="250 rows per page"/>
                                <ComboBoxItem Content="500 rows per page"/>
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Splitter 2 -->
            <GridSplitter Grid.Column="4" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource ThemeBorder}" Cursor="SizeWE"/>

            <!-- COL 3: RIGHT INSPECTOR PANEL (TABLE & FILE DETAILS) -->
            <Border Grid.Column="5" Background="{DynamicResource ThemeSidebarBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,14,14,14">
                        <!-- Inspector Header -->
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Path Data="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtInspectorHeader" Text="Table Details" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Path Data="M5 15l7-7 7 7" Stroke="{DynamicResource ThemeTextMuted}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Properties Grid Items -->
                        <!-- Table Name -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="LblInspectTableName" Text="Table Name" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/>
                            <TextBlock x:Name="ValInspectTableName" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Schema -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="LblInspectSchema" Text="Schema" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/>
                            <TextBlock x:Name="ValInspectSchema" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Object Type -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="LblInspectObjectType" Text="Object Type" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/>
                            <TextBlock x:Name="ValInspectObjectType" Text="USER_TABLE" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Row Count -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="LblInspectRowCount" Text="Row Count" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/>
                            <TextBlock x:Name="ValInspectRowCount" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Columns -->
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock x:Name="LblInspectColumns" Text="Columns" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/>
                            <TextBlock x:Name="ValInspectColumns" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Divider -->
                        <Rectangle Height="1" Fill="{DynamicResource ThemeBorder}" Margin="0,4,0,12"/>

                        <!-- Engine -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="LblInspectEngine" Text="Engine" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/>
                            <TextBlock x:Name="ValInspectEngine" Text="Microsoft SQL Server" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Database -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="LblInspectDb" Text="Database" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/>
                            <TextBlock x:Name="ValInspectDb" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- File Name -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="LblInspectFile" Text="File Name" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/>
                            <TextBlock x:Name="ValInspectFile" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- File Size -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="LblInspectSize" Text="File Size" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/>
                            <TextBlock x:Name="ValInspectSize" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Created -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="LblInspectCreated" Text="Created" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/>
                            <TextBlock x:Name="ValInspectCreated" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Last Modified -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="LblInspectModified" Text="Last Modified" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/>
                            <TextBlock x:Name="ValInspectModified" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="14,4">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatusBar" Text="Ready" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock x:Name="TxtFooterInfo" Text="MDF Lens Studio" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtEngineStatus" Text="Microsoft SQL Server LocalDB Active" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
